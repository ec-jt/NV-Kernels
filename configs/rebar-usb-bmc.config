# Merge onto config-7.0.0-rebar-mixed-5070ti-5090, then run olddefconfig.
# Distinct release preserves the installed working kernel and modules.
CONFIG_LOCALVERSION="-rebar-usb-bmc-test1"
# CONFIG_LOCALVERSION_AUTO is not set
# Keep generic USB keyboard/mouse available before loading the initramfs modules.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# Retain the BMC video and local text-console path.
CONFIG_DRM_AST=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
